surnames = surnames[n>10  & !grepl("\\?",namelast)]
# Renaming columns to match draw_gibbs expectations
colnames(surnames) = c("name","count")
nb = readRDS("~/Downloads/us_names_nb.rds")
post = readRDS("~/Downloads/post_names_all.rds")
# Attempting to build the base US-names dictionary:
# MANUALLY DEFINING DELTA FOR NOW
us_dictionary = make_bayes_choice_dictionary(
surnames$name,
nb$D,
post$p_mean,
delta = 0.1,
median(post$lambda)
)
us_names = standardize_names(
names = all_surnames,
dictionary = us_dictionary,
lambda = median(post$lambda),
delta = 0.1,
method = "jw",
ncores = 10
)
names = all_surnames
dictionary = us_dictionary
lambda = median(post$lambda)
delta = 0.1
method = "jw"
ncores = 10
# Throw a warning if names and dictionary$observed don't overlap
overlap = max(c(mean(names %in% dictionary$observed),
mean(dictionary$observed %in% names)))
if(overlap < 0.5){
warning("Overlap between `names` and `dictionary$observed` is small...\n Are you sure you have the right dictionary?")
}
# Creating a set of standard names from the dictionary
standard_names <- subset(dictionary, !duplicated(standard))
standard_names$observed <- NULL
# Splitting off names missing from the dictionary
missing_observed <- names[ !(names %in% dictionary$observed)] |> unique()
# Making a new dictionary for missing names
chunks <- split(missing_observed,ceiling(seq_along(missing_observed) / 100))
results_list <- pbapply::pblapply(
X   = chunks,
FUN = standardize_missing_name,
cl  = cl
)
standardize_missing_name(chunks[[1]])
names_vec = chunks[[1]]
names_vec
# 1) compute n × m distance matrix
D <- stringdist::stringdistmatrix(
a = names_vec,
b = standard_names$standard,
method = method
)
# 2) threshold by method
thresh <- if (identical(method, "jw")) 0.15 else 3
mask  <- D <= thresh
# 3) raw weights (zero out beyond threshold)
W <- exp(-D / lambda)
W[!mask] <- 0
# 4) unnormalized posterior mass φ_ij = δ * p_j * W_ij
phi <- sweep(
W,
MARGIN = 2,
STATS  = delta * standard_names$p_standard,
FUN    = `*`
)
# 5) normalize across each row
row_sums  <- rowSums(phi)
phi_norm  <- phi / row_sums
phi_norm[row_sums == 0, ] <- NA_real_
# 6) extract max posterior and index
max_post <- apply(phi_norm, 1, max, na.rm = TRUE)
phi_norm
str(phi_norm)
str(row_sums)
# 6) extract max posterior and index
max_post <- apply(phi_norm, 1, max, na.rm = TRUE)
# 6) extract max posterior per row, returning NA if all entries are NA
max_post <- apply(phi_norm, 1, function(x) {
if (all(is.na(x))) {
NA_real_
} else {
max(x, na.rm = TRUE)
}
})
best_idx <- apply(phi_norm, 1, which.max)
# 7) apply cutoff (< 0.75 or no valid candidates → NA)
bad <- is.na(max_post) | max_post < 0.75
best_idx[bad] <- NA_integer_
# 8) map indices back to standardized names
standard_names$standard[best_idx]
best_idx
