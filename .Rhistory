library(nicknamer)        # for clean_surnames(), build_neighbor_matrices(), draw_gibbs()
library(data.table)       # fast I/O and aggregation
library(Matrix)           # sparse‐matrix support
# 1) Load & clean raw name counts
dt <- fread("misc/chunk.csv")
dt[, namelast := clean_surnames(namelast)]
setnames(dt, "namelast", "name")
dt_counts <- dt[, .(count = .N), by = name][order(-count, name)]
# 2) Build sparse distance (D) and mask (M) matrices
nmats <- find_neighbors(
names  = dt_counts$name,
method   = "jw",
max_dist = 0.1,
ncores   = 10
)
D <- nmats$D
M <- nmats$M
# 3) Fix p exogenously as empirical frequencies
p_vec <- dt_counts$count / sum(dt_counts$count)
# 4) Observed counts vector
n_obs <- dt_counts$count
# 5) Run the MH-within-Gibbs sampler
out <- draw_gibbs(
p           = p_vec,
D           = D,
M           = M,
n_obs       = n_obs,
n_iter      = 10000,
delta_init  = 0.1,
lambda_init = 0.1,
sd_logdelta = 0.01,
sd_loglam   = 0.01
)
plot(out$delta)
plot(out$delta, pch = ".")
plot(out$delta[2000:1000], pch = ".")
plot(out$lambda[2000:1000], pch = ".")
plot(out$delta[2000:1000], pch = ".")
# 5) Run the MH-within-Gibbs sampler
out <- draw_gibbs(
p           = p_vec,
D           = D,
M           = M,
n_obs       = n_obs,
n_iter      = 10000,
delta_init  = 0.1,
lambda_init = 0.1,
sd_logdelta = 0.1,
sd_loglam   = 0.1
)
# 6) Quick convergence diagnostics
par(mfrow = c(2,1))
plot(out$delta,  type = "l", main = "Trace of δ",     ylab = "delta")
plot(out$lambda, type = "l", main = "Trace of λ", ylab = "lambda")
plot(out$delta[5000:10000],  type = "l", main = "Trace of δ",     ylab = "delta")
plot(out$lambda[5000:10000], type = "l", main = "Trace of λ", ylab = "lambda")
plot(out$delta[5000:10000], out$lambda[5000:10000])
summary(out$lambda)
plot(density(rgamma(10000,1,1)))
plot(density(rgamma(10000,9,1)))
plot(density(rgamma(10000,1,9)))
