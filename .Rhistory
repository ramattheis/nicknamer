setnames(dt, "namelast", "name")
dt_counts <- dt[, .(count = .N), by = name][order(-count, name)]
# 2) Build sparse distance (D) and mask (M) matrices
nmats <- find_neighbors(
strings  = dt_counts$name,
method   = "jw",
max_dist = 0.1,
ncores   = 10
)
# 2) Build sparse distance (D) and mask (M) matrices
nmats <- find_neighbors(
names  = dt_counts$name,
method   = "jw",
max_dist = 0.1,
ncores   = 10
)
D <- nmats$D
M <- nmats$M
# 3) Fix p exogenously as empirical frequencies
p_vec <- dt_counts$count / sum(dt_counts$count)
# 4) Observed counts vector
n_obs <- dt_counts$count
# 5) Run the MH-within-Gibbs sampler
out <- draw_gibbs(
p           = p_vec,
D           = D,
M           = M,
n_obs       = n_obs,
n_iter      = 10,       # you can crank this up
delta_init  = 0.05,
lambda_init = 1.0,
sd_delta    = 0.01,
sd_loglam   = 0.05
)
# 5) Run the MH-within-Gibbs sampler
out <- draw_gibbs(
p           = p_vec,
D           = D,
M           = M,
n_obs       = n_obs,
n_iter      = 1000,       # you can crank this up
delta_init  = 0.05,
lambda_init = 1.0,
sd_delta    = 0.01,
sd_loglam   = 0.05
)
out$delta
plot(out)
plot(out$delta)
plot(out$lambda)
