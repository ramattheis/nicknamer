if(phi_self > max(phis)){
bayes_choice_id = id
} else {
bayes_choice_id = nbs$j[which(phis) == max(phis)][1]
}
}
# Returning self + bayes choice
as.data.frame(cbind(observed, bayes_choice_id))
}
# Setting up the cluster
