)
D <- nmats$D
M <- nmats$M
# 3) Fix p exogenously as slightly squished empirical frequencies
p_vec <- dt_counts$count / sum(dt_counts$count)
# 4) Observed counts vector
n_obs <- dt_counts$count
# 5) Run the MH-within-Gibbs sampler
